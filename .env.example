# Copy to .env and adjust. Every Settings field can be overridden with RAG_<NAME>.

# --- Claude (default) ---
# ANTHROPIC_API_KEY=sk-ant-...
RAG_LLM_PROVIDER=anthropic
RAG_LLM_MODEL=claude-opus-5-5
RAG_LLM_EFFORT=low

# --- Local model via LM Studio / Ollama (OpenAI-compatible server) ---
# RAG_LLM_PROVIDER=openai_compat
# RAG_LLM_BASE_URL=http://localhost:1234/v1
# RAG_LLM_MODEL=qwen2.5-7b-instruct

# --- Retrieval ---
RAG_RETRIEVAL_MODE=hybrid
RAG_USE_RERANKER=false
